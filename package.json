{
  "name": "stdev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "prettier:write": "prettier --write .",
    "prettier:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "notion:fetch": "tsx src/scripts/notion-import/fetch-notion.ts",
    "notion:convert": "tsx src/scripts/notion-import/convert.ts",
    "notion:import": "tsx src/scripts/notion-import/import.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=test-results/junit.xml",
    "e2e:build": "node src/scripts/build-playwright-e2e.mjs",
    "e2e:prepare": "node src/scripts/prepare-playwright-e2e.mjs",
    "test:e2e": "pnpm e2e:build && playwright test",
    "test:e2e:ui": "pnpm e2e:build && playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
