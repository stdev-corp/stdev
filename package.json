    "better-auth": "^1.7.25",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
