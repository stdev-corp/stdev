generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String?
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Business {
  id           Int                   @id @default(autoincrement())
  name         String                @unique
  code         String                @unique
  /// 공개 주소의 슬러그. 비어 있으면 행사 페이지를 만들지 않는다.
  slug         String?               @unique
  category     BusinessCategory      @default(hackathon)
  startDate    DateTime
  endDate      DateTime
  /// true면 시작/종료 시각까지 표시한다. false면 날짜만 쓴다.
  hasTime      Boolean               @default(false)
  location     String?
  /// 노션 페이지 아이콘. 이모지 또는 이미지 URL.
  icon         String?
  coverImageId Int?
  coverImage   ImageAsset?           @relation("BusinessCover", fields: [coverImageId], references: [id], onDelete: Restrict)
  /// 행사 목록에 보이는 요약(마크다운).
  summary      String?
  /// 행사 페이지 본문(노션 확장 마크다운).
  content      String                @default("")
  /// 이전 노션 페이지 ID. 옛 주소를 새 주소로 넘기는 데 쓴다.
  notionId     String?               @unique
  webpages     Webpage[]
  pages        BusinessPage[]
  institutions BusinessInstitution[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

/// 행사 아래의 하위 페이지(FAQ, 동의서, 참가자 안내 등).
model BusinessPage {
  id           Int         @id @default(autoincrement())
  businessId   Int
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// 행사 주소 아래의 경로. 예: "faq", "notice/team-building"
  path         String
  title        String
  icon         String?
  coverImageId Int?
  coverImage   ImageAsset? @relation("BusinessPageCover", fields: [coverImageId], references: [id], onDelete: Restrict)
  content      String      @default("")
  notionId     String?     @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([businessId, path])
}

/// 행사와 주최·주관·후원·협력 기관의 연결.
model BusinessInstitution {
  businessId    Int
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  institutionId Int
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  role          BusinessRole
  sortOrder     Int          @default(0)

  @@id([businessId, institutionId, role])
}

model FileAsset {
  id           Int       @id @default(autoincrement())
  filename     String
  url          String?
  mimeType     String?
  filesize     Int?
  prefix       String?   @default("files")
  thumbnailURL String?
  width        Int?
  height       Int?
  focalX       Int?
  focalY       Int?
  reports      Report[]
  /// 이 파일을 원문 저장본으로 둔 웹페이지
  webpages     Webpage[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ImageAsset {
  id            Int            @id @default(autoincrement())
  alt           String?
  filename      String?
  url           String?
  mimeType      String?
  filesize      Int?
  prefix        String?        @default("images")
  thumbnailURL  String?
  width         Int?
  height        Int?
  focalX        Int?
  focalY        Int?
  histories     History[]
  institutions  Institution[]
  businesses    Business[]     @relation("BusinessCover")
  businessPages BusinessPage[] @relation("BusinessPageCover")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model History {
  id        Int         @id @default(autoincrement())
  date      DateTime
  title     String
  content   String?
  imageId   Int?
  image     ImageAsset? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Institution {
  id         Int                   @id @default(autoincrement())
  nameKo     String                @unique
  nameEn     String?               @unique
  url        String?               @unique
  logoId     Int?                  @unique
  logo       ImageAsset?           @relation(fields: [logoId], references: [id], onDelete: Restrict)
  /// 홈 '함께하는 기관' 로고 흐름에 보일지 여부. 로고가 있어야 보인다.
  showOnHome Boolean               @default(true)
  businesses BusinessInstitution[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
}

model Markdown {
  id            Int          @id @default(autoincrement())
  type          MarkdownType
  revisionDate  DateTime
  effectiveDate DateTime
  content       String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Report {
  id            Int        @id @default(autoincrement())
  title         String
  publishedDate DateTime
  type          ReportType
  fileId        Int        @unique
  file          FileAsset  @relation(fields: [fileId], references: [id], onDelete: Restrict)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Webpage {
  id            Int         @id @default(autoincrement())
  url           String      @unique
  title         String
  author        String
  publishedDate DateTime
  businessId    Int?
  business      Business?   @relation(fields: [businessId], references: [id], onDelete: SetNull)
  type          WebpageType
  /// 원문이 사라질 때를 대비한 PDF 저장본. 관리자 화면에만 보인다. 저장본으로 쓰는 파일은
  /// 연결을 먼저 풀어야 지울 수 있다.
  archiveId     Int?
  archive       FileAsset?  @relation(fields: [archiveId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model AdminSettings {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MarkdownType {
  articles
  privacy
  terms
  /// 해커톤&아이디어톤 구역 소개
  hackathon
  /// 컨퍼런스&프로그램 구역 소개
  conference
}

enum BusinessCategory {
  hackathon
  ideathon
  conference
  program
}

enum BusinessRole {
  host
  organizer
  sponsor
  partner
}

enum ReportType {
  meeting
  donation
}

enum WebpageType {
  blog_post
  news_article
  press_release
}
